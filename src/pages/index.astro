---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SystemCards from '../components/SystemCards.astro';
import PostList from '../components/PostList.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base
  title="Dahai Tang — operations person who builds with AI"
  description="Dahai Tang, Berlin. Eight years in strategy and operations. I build my own systems with AI and write about what works."
  bare
  showNav
>
  <section class="wrap hero">
    <p class="hello">Hi, I'm Dahai 👋</p>
    <h1 class="disp">Operations person who <mark>builds with AI</mark>.</h1>
    <p class="sub">
      Eight years in strategy and operations at startups and global tech
      companies, most recently TikTok. Based in Berlin.
    </p>
    <div class="btn-row cta">
      <a class="btn solid" href="/projects/">See what I built</a>
      <a class="btn" href="/about/">About me</a>
    </div>
    <ul class="stats">
      <li><b>8</b><span>years in strategy &amp; operations</span></li>
      <li><b>{projects.length}</b><span>systems built for my own life</span></li>
      <li><b>3</b><span>languages: Mandarin, English, some German</span></li>
    </ul>
  </section>

  <section class="wrap block">
    <h2 class="disp">Things I built</h2>
    <p class="lead">Six small systems. Each one fixes a problem I actually had.</p>
    <SystemCards projects={projects} />
  </section>

  <section class="wrap block">
    <h2 class="disp">Writing</h2>
    <p class="lead">Short notes on what works and what does not.</p>
    <PostList posts={posts} />
    <p class="all"><a href="/writing/">All writing →</a></p>
  </section>

  <section class="wrap block">
    <div class="contact">
      <h2 class="disp">Want to talk?</h2>
      <p>Operations, growth, building with AI. I am in Berlin.</p>
      <div class="btn-row">
        <a class="btn solid" href="mailto:dahai.tang1@gmail.com">E-mail me</a>
        <a class="btn" href="https://www.linkedin.com/in/dahaitang" rel="me noopener">LinkedIn</a>
        <a class="btn" href="https://github.com/dahaitang1-boop" rel="me noopener">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 8vh, 5rem) 1rem;
  }
  .hello {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 7.5vw, 5.4rem);
    line-height: 1;
    letter-spacing: -0.05em;
    max-width: 14ch;
  }
  mark {
    background: linear-gradient(transparent 58%, var(--accent-soft) 58%);
    color: var(--accent);
    padding: 0 0.05em;
  }
  .sub {
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    max-width: 44ch;
    margin: 1.5rem 0 0;
  }
  .cta {
    margin-top: 1.75rem;
  }
  .stats {
    list-style: none;
    padding: 1.5rem 0 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
    border-top: 1.5px solid var(--ink);
  }
  .stats li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .stats b {
    font-family: var(--brand);
    font-weight: 800;
    font-size: 3rem;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--accent);
  }
  .stats span {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.35;
    max-width: 16ch;
  }
  .block {
    padding-top: 3.5rem;
  }
  .lead {
    color: var(--muted);
    margin: 0.5rem 0 1.75rem;
    font-size: 1.1rem;
  }
  .all {
    margin: 1.25rem 0 0;
    font-weight: 600;
  }
  .all a {
    text-decoration: none;
  }
  .contact {
    background: var(--ink);
    color: #fff;
    border-radius: 28px;
    padding: clamp(2rem, 6vw, 4rem);
  }
  .contact h2 {
    color: #fff;
    margin: 0;
  }
  .contact p {
    color: #b9bbc0;
    margin: 0.75rem 0 1.75rem;
  }
  .contact .btn {
    border-color: #fff;
    box-shadow: none;
  }
  .contact .btn.solid {
    border-color: var(--accent);
  }
</style>
