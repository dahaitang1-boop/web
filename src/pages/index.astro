---
import Base from '../layouts/Base.astro';
---

<Base
  title="Dahai Tang"
  description="Dahai Tang — engineer in Berlin. Site under construction."
  bare
  noindex
  minimal
>
  <section class="wrap wip">
    <p class="k">Berlin, Germany</p>
    <h1 class="disp">Dahai&nbsp;Tang<span class="dot">.</span></h1>

    <p class="lede">Engineer. Building things in Berlin.</p>

    <p class="note">
      This site is a work in progress — I'm still writing it. If you're here
      because I sent you a link, that link still works.
    </p>

    <ul class="chips">
      <li><a class="chip" href="mailto:dahai.tang1@gmail.com">e-mail</a></li>
      <li>
        <a class="chip" href="https://github.com/dahaitang1-boop" rel="me noopener">github</a>
      </li>
    </ul>
  </section>
</Base>

<style>
  .wip {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(3rem, 14vh, 8rem) 2rem;
    max-width: 40rem;
  }
  .wip h1 {
    margin-block: 0.75rem 0;
  }
  .dot {
    color: var(--accent);
  }
  .note {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 44ch;
    margin: 1.75rem 0 2rem;
  }
  .chip {
    text-decoration: none;
  }
  .chip:hover {
    border-color: var(--accent);
  }
</style>
