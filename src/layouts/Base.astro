---
import '../styles/tokens.css';
import { WIP } from '../config';

interface Props {
  title: string;
  description: string;
  /** Omit on the homepage so the <title> is not "Dahai Tang — Dahai Tang". */
  bare?: boolean;
  /** Force noindex on a single page. While WIP, every page is noindex anyway. */
  noindex?: boolean;
  /** Hide the header navigation. Implied by WIP. */
  minimal?: boolean;
  /** Show the header navigation even while WIP. Used by the redesign
   *  prototype at /index-full/ so it can be reviewed as it will launch. */
  showNav?: boolean;
}

const { title, description, bare = false, noindex = false, minimal = false, showNav = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = bare ? title : `${title} — Dahai Tang`;

// While the site is unfinished the case studies stay reachable by direct link
// but must not be crawled, and nothing on the page may link onward to them.
const hideNav = (WIP && !showNav) || minimal;
const blockIndexing = WIP || noindex;

const nav = [
  { href: '/projects/', label: 'Systems' },
  { href: '/writing/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
const here = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="wrap site-head">
      <a class="mark" href="/" aria-label="Dahai Tang — home">Dahai Tang</a>
      {
        !hideNav && (
          <nav aria-label="Primary">
            {nav.map((n) => (
              <a
                class="navlink"
                href={n.href}
                aria-current={here.startsWith(n.href) ? 'page' : undefined}
              >
                {n.label}
              </a>
            ))}
            <a class="pill" href="mailto:dahai.tang1@gmail.com">Say hi</a>
          </nav>
        )
      }
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="wrap site-foot">
      <div class="foot-grid">
        <p class="k">© Dahai Tang · Berlin</p>
        <ul class="foot-links">
          <li><a href="mailto:dahai.tang1@gmail.com">E-mail</a></li>
          <li><a href="https://www.linkedin.com/in/dahaitang" rel="me noopener">LinkedIn</a></li>
          <li><a href="https://github.com/dahaitang1-boop" rel="me noopener">GitHub</a></li>
          {!hideNav && <li><a href="/privacy/">Privacy</a></li>}
        </ul>
      </div>
      <p class="foot-note">No analytics. No cookies.</p>
    </footer>

    <style>
      .site-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1rem;
        padding-block: 1.25rem;
        flex-wrap: wrap;
      }
      .mark {
        font-family: var(--brand);
        font-weight: 800;
        letter-spacing: -0.04em;
        font-size: 1.25rem;
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
        line-height: 1;
      }
      .mark:hover {
        color: var(--accent);
      }
      nav {
        display: flex;
        align-items: center;
        gap: 0.5rem 1.3rem;
        flex-wrap: wrap;
      }
      .navlink {
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
      }
      .navlink:hover,
      .navlink[aria-current='page'] {
        color: var(--accent);
      }
      .pill {
        background: var(--ink);
        color: #fff;
        font-size: 0.95rem;
        font-weight: 500;
        padding: 0.4rem 1rem;
        border-radius: 999px;
        text-decoration: none;
      }
      .pill:hover {
        background: var(--accent);
        color: #fff;
      }
      .site-foot {
        margin-top: 4rem;
        padding-block: 1.5rem 3rem;
        border-top: 1.5px solid var(--ink);
      }
      .foot-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        align-items: center;
        justify-content: space-between;
      }
      .foot-grid p {
        margin: 0;
      }
      .foot-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.92rem;
        font-weight: 500;
      }
      .foot-links a {
        color: var(--ink);
        text-decoration: none;
      }
      .foot-links a:hover {
        color: var(--accent);
      }
      .foot-note {
        margin: 0.75rem 0 0;
        color: var(--muted);
        font-size: 0.85rem;
      }
    </style>
  </body>
</html>
