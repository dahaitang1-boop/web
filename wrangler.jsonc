{
  // Assets-only Worker: no script, just Astro's static build output.
  // Cloudflare Workers Builds runs `npm run build` (which runs the secret
  // scanner first) and then `npx wrangler deploy`.
  //
  // "name" must stay "web" — it is the existing Worker. Renaming it here
  // would create a second Worker and orphan the deployed one.
  "name": "web",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./dist",
    // Left at the default ("auto-trailing-slash"). Note the consequence:
    // /artifacts/.../planner.html 307s to the extensionless /planner. The
    // content is identical and every page route works, so this is cosmetic —
    // the "save a copy" affordance is handled in the UI with a download
    // attribute rather than by overriding asset routing.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
